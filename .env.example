# Copy to .env and fill in. Never commit .env.

# ---- Generator LLM: any OpenAI-compatible endpoint ----
# Local, free (default): Ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:4b
LLM_REASONING_EFFORT=none
# Hosted free tier (recommended; measured in evals/RESULTS.md): Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
# LLM_MAX_RPM=25
# Note: Gemini's free tier allowed only 20 requests/day per model when tested (2026-10), too few for evals
# Hosted free tier example (Gemini, OpenAI-compatible endpoint):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=...
# LLM_MODEL=gemini-2.5-flash
LLM_CACHE=false

# ---- Judge LLM for evals (defaults to the generator); use a different model family ----
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_MODEL=qwen/qwen3.8-27b
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=
JUDGE_BUDGET_USD=5
# JUDGE_PRICE_PER_MTOK_IN=0
# JUDGE_PRICE_PER_MTOK_OUT=0

# ---- Retrieval ----
# QDRANT_URL=http://qdrant:6333   # unset = embedded local Qdrant
ENABLE_RERANK=true

# ---- Observability (Langfuse cloud free tier or self-hosted) ----
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
ONLINE_EVAL_SAMPLE_RATE=0.1

# ---- API ----
# DEMO_TOKEN=change-me
RATE_LIMIT_PER_MIN=20
